{
  "name": "health-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "postinstall": "npx prisma generate --schema=packages/db/prisma/schema.prisma"
  },
  "overrides": { "react": "^18.3.1", "react-dom": "^18.3.1" },
  "dependencies": {
    "turbo": "latest"
  },
  "packageManager": "npm@10.0.0"
}
